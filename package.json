{
  "name": "pi-taste",
  "version": "0.5.6",
  "description": "Local, transparent Taste learning for the Pi coding agent",
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "*.ts",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "test:coverage": "tsx --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=75 --test-coverage-functions=85 \"test/**/*.test.ts\"",
    "test:e2e": "node test/e2e/run-real-provider.mjs",
    "check": "npm run typecheck && npm run test:coverage",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "taste",
    "preferences",
    "preference-learning",
    "ai",
    "llm"
  ],
  "author": "LycanW",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LycanW/pi-taste.git"
  },
  "homepage": "https://github.com/LycanW/pi-taste#readme",
  "bugs": {
    "url": "https://github.com/LycanW/pi-taste/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
